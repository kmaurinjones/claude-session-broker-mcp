#!/usr/bin/env zsh
set -euo pipefail

if [[ $# -lt 1 ]]; then
  echo "Usage: cc-session <session-name> [group-name] [-- claude args...]" >&2
  exit 1
fi

session_name="$1"
shift

group_name="main"
if [[ $# -gt 0 && "$1" != "--" ]]; then
  group_name="$1"
  shift
fi

if [[ $# -gt 0 && "$1" == "--" ]]; then
  shift
fi

export CC_NAME="$session_name"
export CC_GROUP="$group_name"
export CLAUDE_SESSION_BROKER_NAME="$session_name"
export CLAUDE_SESSION_BROKER_GROUP="$group_name"

args=("$@")
has_channel_flag="0"
for arg in "${args[@]}"; do
  if [[ "$arg" == "--dangerously-load-development-channels" ]]; then
    has_channel_flag="1"
    break
  fi
done

if [[ "$has_channel_flag" == "0" ]]; then
  args+=(--dangerously-load-development-channels server:session-broker)
fi

exec claude "${args[@]}"
